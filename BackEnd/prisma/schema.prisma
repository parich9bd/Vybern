generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CUSTOMER
  SUPER_ADMIN
  ADMIN
  STAFF
  SUPPORT
}

enum UserStatus {
  ACTIVE
  SUSPENDED
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ModelFormat {
  GLB
  GLTF
  USDZ
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  CANCELLED
  EXPIRED
  FULFILLED
}

enum FulfillmentStatus {
  UNFULFILLED
  PROCESSING
  SHIPPED
  DELIVERED
}

enum PaymentProvider {
  MOCK
  ZARINPAL
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
}

enum InventoryMovementType {
  ADJUSTMENT
  RECEIPT
  DAMAGE
  RETURN
}
enum DiscountType {
  PERCENTAGE
  FIXED
}
enum DiscountRedemptionStatus {
  RESERVED
  CONSUMED
  RELEASED
}
enum NotificationOutboxStatus {
  PENDING
  PROCESSING
  DELIVERED
  FAILED
}

enum ServiceRequestType {
  EYE_EXAM
  LENS_UPGRADE
}

enum ServiceRequestStatus {
  PENDING
  REVIEWING
  CONTACTED
  CLOSED
}

model User {
  id        String     @id @default(cuid())
  phone     String     @unique @db.VarChar(16)
  firstName String?    @db.VarChar(100)
  lastName  String?    @db.VarChar(100)
  avatarKey String?    @db.VarChar(128)
  avatarContentType String? @db.VarChar(32)
  avatarUpdatedAt DateTime?
  role      UserRole   @default(CUSTOMER)
  status    UserStatus @default(ACTIVE)
  sessions  Session[]
  cart      Cart?
  orders    Order[]
  auditLogs AuditLog[] @relation("AuditActor")
  adminProvisioningEvents AdminProvisioningEvent[] @relation("ProvisioningTarget")
  addresses CustomerAddress[]
  discountRedemptions DiscountRedemption[]
  serviceRequests ServiceRequest[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model ServiceRequest {
  id                       String               @id @default(cuid())
  reference                String               @unique @db.VarChar(24)
  idempotencyKey           String               @unique @db.VarChar(128)
  type                     ServiceRequestType
  status                   ServiceRequestStatus @default(PENDING)
  userId                   String?
  fullName                 String               @db.VarChar(160)
  phone                    String               @db.VarChar(16)
  email                    String?              @db.VarChar(254)
  examinationType          String?              @db.VarChar(64)
  preferredDate            DateTime?
  preferredTime            String?              @db.VarChar(16)
  frameBrand               String?              @db.VarChar(120)
  frameModel               String?              @db.VarChar(120)
  lensType                 String?              @db.VarChar(64)
  prescriptionAvailability String?              @db.VarChar(64)
  consultationDate         DateTime?
  notes                    String?              @db.VarChar(1000)
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  user                     User?                @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([type, status, createdAt])
  @@index([phone, createdAt])
  @@index([userId, createdAt])
}

model StoreSettings {
  id                Int      @id @default(1)
  storeName         String   @db.VarChar(160)
  storeDescription  String?  @db.VarChar(2000)
  contactEmail      String?  @db.VarChar(254)
  contactPhone      String?  @db.VarChar(16)
  supportInfo       String?  @db.VarChar(2000)
  supportedLanguages String[] @default(["en", "fa", "de"])
  defaultLanguage   String   @default("fa") @db.VarChar(8)
  defaultCurrency   String   @default("IRR") @db.Char(3)
  maintenanceMode   Boolean  @default(false)
  seoTitle          String?  @db.VarChar(160)
  seoDescription    String?  @db.VarChar(320)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model NotificationOutbox {
  id            String                    @id @default(cuid())
  eventType     String                    @db.VarChar(80)
  aggregateId   String                    @db.VarChar(64)
  deduplicationKey String?                @unique @db.VarChar(180)
  payload       Json
  status        NotificationOutboxStatus  @default(PENDING)
  attemptCount  Int                       @default(0)
  nextAttemptAt DateTime                  @default(now())
  lastError     String?                   @db.VarChar(1000)
  processingAt  DateTime?
  leaseExpiresAt DateTime?
  deliveredAt   DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt

  @@index([status, nextAttemptAt])
  @@index([leaseExpiresAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  action      String   @db.VarChar(120)
  targetType  String   @db.VarChar(80)
  targetId    String?  @db.VarChar(64)
  metadata    Json?
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(512)
  actor       User     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([actorUserId, createdAt])
  @@index([targetType, targetId, createdAt])
  @@index([action, createdAt])
}

model AdminProvisioningEvent {
  id             String   @id @default(cuid())
  targetUserId   String
  operation      String   @db.VarChar(80)
  operatorLabel  String   @db.VarChar(120)
  target         User     @relation("ProvisioningTarget", fields: [targetUserId], references: [id], onDelete: Restrict)
  createdAt      DateTime @default(now())

  @@unique([targetUserId, operation])
  @@index([createdAt])
}

model Order {
  id                     String               @id @default(cuid())
  userId                 String
  status                 OrderStatus          @default(PENDING_PAYMENT)
  fulfillmentStatus      FulfillmentStatus    @default(UNFULFILLED)
  idempotencyKey         String               @db.VarChar(128)
  currency               String               @db.Char(3)
  subtotalMinor          Int
  totalMinor             Int
  discountMinor          Int                  @default(0)
  shippingMinor          Int                  @default(0)
  discountCode           String?              @db.VarChar(64)
  shippingMethod         String?              @db.VarChar(80)
  deliveryEstimateDays   Int?
  reservationExpiresAt   DateTime?
  trackingNumber         String?              @db.VarChar(100)
  shippedAt              DateTime?
  deliveredAt            DateTime?
  user                   User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  items                  OrderItem[]
  shippingAddress        OrderShippingAddress?
  payment                Payment?
  internalNotes          OrderNote[]
  createdAt              DateTime             @default(now())
  updatedAt              DateTime             @updatedAt

  @@unique([userId, idempotencyKey])
  @@index([userId, createdAt])
  @@index([status, reservationExpiresAt])
  @@index([fulfillmentStatus, createdAt])
}
model Discount {
 id String @id @default(cuid())
 code String @unique @db.VarChar(64)
 type DiscountType
 amount Int
 minimumOrderMinor Int @default(0)
 usageLimit Int?
 perCustomerLimit Int?
 startsAt DateTime?
 expiresAt DateTime?
 isActive Boolean @default(true)
 usageCount Int @default(0)
 redemptions DiscountRedemption[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([isActive, expiresAt])
}
model DiscountRedemption {
 id String @id @default(cuid())
 discountId String
 userId String
 orderId String @unique
 amountMinor Int
  status DiscountRedemptionStatus @default(RESERVED)
  releasedAt DateTime?
  consumedAt DateTime?
 discount Discount @relation(fields:[discountId], references:[id], onDelete: Restrict)
 user User @relation(fields:[userId], references:[id], onDelete: Restrict)
 createdAt DateTime @default(now())
 @@index([discountId,userId])
}
model CustomerAddress {
 id String @id @default(cuid())
 userId String
 firstName String @db.VarChar(100)
 lastName String @db.VarChar(100)
 phone String @db.VarChar(16)
 addressLine1 String @db.VarChar(200)
 addressLine2 String? @db.VarChar(200)
 city String @db.VarChar(100)
 province String @db.VarChar(100)
 postalCode String @db.Char(10)
 isDefault Boolean @default(false)
 user User @relation(fields:[userId],references:[id],onDelete:Cascade)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([userId,isDefault])
}
model ShippingRate {
 id String @id @default(cuid())
 province String @unique @db.VarChar(100)
 method String @db.VarChar(80)
 priceMinor Int
 estimatedDays Int
 isActive Boolean @default(true)
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
 @@index([isActive,province])
}

model OrderNote {
  id           String   @id @default(cuid())
  orderId      String
  authorUserId String   @db.VarChar(32)
  body         String   @db.VarChar(1000)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([authorUserId, createdAt])
}

model Payment {
  id           String          @id @default(cuid())
  orderId      String          @unique
  provider     PaymentProvider
  amountMinor  Int
  currency     String          @db.Char(3)
  status       PaymentStatus   @default(PENDING)
  verifiedAt   DateTime?
  expiresAt    DateTime?
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  attempts     PaymentAttempt[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([status, expiresAt])
}

model PaymentAttempt {
  id                String        @id @default(cuid())
  paymentId         String
  providerReference String        @unique @db.VarChar(160)
  status            PaymentStatus @default(PENDING)
  amountMinor       Int
  currency          String        @db.Char(3)
  expiresAt         DateTime?
  completedAt       DateTime?
  failureCode       String?       @db.VarChar(64)
  payment           Payment       @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  createdAt         DateTime      @default(now())

  @@index([paymentId, createdAt])
  @@index([status, expiresAt])
}

model OrderItem {
  id              String   @id @default(cuid())
  orderId         String
  productId       String?  @db.VarChar(32)
  variantId       String?  @db.VarChar(32)
  productSlug     String   @db.VarChar(160)
  productSku      String   @db.VarChar(64)
  productName     String   @db.VarChar(180)
  variantSku      String   @db.VarChar(64)
  variantName     String   @db.VarChar(120)
  variantColour   String?  @db.VarChar(80)
  unitPriceMinor  Int
  quantity        Int
  lineTotalMinor  Int
  currency        String   @db.Char(3)
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([orderId])
}

model OrderShippingAddress {
  id           String   @id @default(cuid())
  orderId      String   @unique
  firstName    String   @db.VarChar(100)
  lastName     String   @db.VarChar(100)
  phone        String   @db.VarChar(16)
  addressLine1 String   @db.VarChar(200)
  addressLine2 String?  @db.VarChar(200)
  city         String   @db.VarChar(100)
  region       String?  @db.VarChar(100)
  postalCode   String   @db.VarChar(32)
  countryCode  String   @db.Char(2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())
}

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  currency  String?    @db.Char(3)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([updatedAt])
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  variantId String
  quantity  Int
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([cartId, variantId])
  @@index([variantId])
}

model Session {
  id            String    @id @default(cuid())
  userId        String
  tokenHash     String    @unique @db.Char(64)
  csrfTokenHash String    @db.Char(64)
  expiresAt     DateTime
  revokedAt     DateTime?
  ipAddress     String?   @db.VarChar(45)
  userAgent     String?   @db.VarChar(512)
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model Category {
  id           String               @id @default(cuid())
  slug         String               @unique @db.VarChar(120)
  position     Int                  @default(0)
  isActive     Boolean              @default(true)
  translations CategoryTranslation[]
  products     Product[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([isActive, position])
}

model CategoryTranslation {
  id         String   @id @default(cuid())
  categoryId String
  locale     String   @db.VarChar(5)
  name       String   @db.VarChar(120)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([locale, name])
}

model Product {
  id                 String               @id @default(cuid())
  slug               String               @unique @db.VarChar(160)
  sku                String               @unique @db.VarChar(64)
  status             ProductStatus        @default(DRAFT)
  categoryId         String
  basePriceMinor     Int
  currency           String               @db.Char(3)
  isFeatured         Boolean              @default(false)
  tryOnAvailable     Boolean              @default(false)
  tryOnModelUrl      String?              @db.VarChar(2048)
  tryOnModelFormat   ModelFormat?
  frameWidthMm       Int?
  lensWidthMm        Int?
  bridgeWidthMm      Int?
  templeLengthMm     Int?
  calibration        Json?
  specifications     Json?
  category           Category             @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  translations       ProductTranslation[]
  images             ProductImage[]
  variants           ProductVariant[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status, isFeatured, createdAt])
  @@index([categoryId, status])
}

model ProductTranslation {
  id          String  @id @default(cuid())
  productId   String
  locale      String  @db.VarChar(5)
  name        String  @db.VarChar(180)
  description String? @db.Text
  material    String? @db.VarChar(120)
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
  @@index([locale, name])
}

model ProductImage {
  id           String      @id @default(cuid())
  productId    String
  mediaAssetId String?
  url          String      @db.VarChar(2048)
  alt          String?     @db.VarChar(255)
  position     Int         @default(0)
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  mediaAsset   MediaAsset? @relation(fields: [mediaAssetId], references: [id], onDelete: Restrict)

  @@unique([productId, position])
  @@unique([productId, mediaAssetId])
  @@index([mediaAssetId])
}

model MediaAsset {
  id              String         @id @default(cuid())
  storageKey      String         @unique @db.VarChar(180)
  sha256          String         @unique @db.Char(64)
  originalName    String         @db.VarChar(255)
  contentType     String         @db.VarChar(32)
  byteSize        Int
  altTextEn       String?        @db.VarChar(255)
  altTextFa       String?        @db.VarChar(255)
  altTextDe       String?        @db.VarChar(255)
  createdByUserId String         @db.VarChar(32)
  deletedAt       DateTime?
  productImages   ProductImage[]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([deletedAt, createdAt])
  @@index([createdByUserId, createdAt])
}

model ProductVariant {
  id           String   @id @default(cuid())
  productId    String
  sku          String   @unique @db.VarChar(64)
  name         String   @db.VarChar(120)
  colour       String?  @db.VarChar(80)
  priceMinor   Int?
  stockOnHand  Int      @default(0)
  stockReserved Int     @default(0)
  isActive     Boolean  @default(true)
  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cartItems    CartItem[]
  inventoryMovements InventoryMovement[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([productId, isActive])
}

model InventoryMovement {
  id              String                @id @default(cuid())
  variantId       String
  actorUserId     String
  type            InventoryMovementType
  quantityDelta   Int
  stockBefore     Int
  stockAfter      Int
  reason          String                @db.VarChar(200)
  note            String?               @db.VarChar(500)
  variant         ProductVariant        @relation(fields: [variantId], references: [id], onDelete: Restrict)
  createdAt       DateTime              @default(now())

  @@index([variantId, createdAt])
  @@index([actorUserId, createdAt])
}
