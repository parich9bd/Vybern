NODE_ENV=development
PORT=3001
HOST=0.0.0.0
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5433/DATABASE_NAME?schema=public
# These values are also consumed by docker compose. Use unique local development values.
POSTGRES_USER=USERNAME
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=DATABASE_NAME
# Required by Vitest integration tests. Use a distinct database; never reuse DATABASE_URL.
# TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5433/vybern_test?schema=public
CORS_ORIGIN=http://localhost:3000
LOG_LEVEL=info
REDIS_URL=redis://localhost:6379
# Must be a unique random string of at least 32 characters. Generate with: openssl rand -hex 32
AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters-long
AUTH_COOKIE_NAME=vybern_session
# In production this must be true. SameSite=None requires HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax
AUTH_SESSION_TTL_DAYS=7
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE=5
OTP_REQUEST_LIMIT_PER_IP=10
OTP_RATE_LIMIT_WINDOW_SECONDS=900
# No paid SMS provider is implemented. The development provider is only enabled for NODE_ENV=development.
SMS_PROVIDER=development
# Mock payments are strictly development-only. Production requires a real provider integration.
PAYMENT_PROVIDER=mock
ORDER_EXPIRATION_INTERVAL_SECONDS=60
# Keep uploads outside a public/static directory. Production requires an absolute path.
MEDIA_STORAGE_PATH=./private/media
MEDIA_MAX_FILE_SIZE_BYTES=5000000
# One-time CLI bootstrap only. Do not put these in a committed file.
# ADMIN_BOOTSTRAP_PHONE=+989...
# ADMIN_BOOTSTRAP_TOKEN=generated-secret
# ADMIN_BOOTSTRAP_TOKEN_HASH=sha256-of-generated-secret
